# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration
# Replace with your MongoDB Atlas URI or local MongoDB URI
MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/campushync

# Security
# Generate a secret using: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your_jwt_secret_key_here

# Frontend/Client Configuration
CLIENT_ORIGIN=http://localhost:5173

# Cloudinary Configuration (Used for media uploads)
# Note: These are also used by the frontend
VITE_CLOUDINARY_CLOUD_NAME=your_cloud_name
VITE_CLOUDINARY_UPLOAD_PRESET=your_upload_preset

# API URL (Used for internal references if applicable)
VITE_API_URL=http://localhost:5000/api
